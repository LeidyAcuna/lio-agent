    {
      "id": "LsNVinRvRjtbEW9sIOl9O",
      "type": "text",
      "x": 263.2491816377815,
      "y": 227.2492561021436,
      "width": 795.1192626953125,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
