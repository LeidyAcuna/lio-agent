      "containerId": null,
      "originalText": "                                             LIO \nUn asistente personal que vive en Telegram, procesa lenguaje natural (texto y voz) \ny gestiona una base de datos local para dar reportes instantáneos.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LsNVinRvRjtbEW9sIOl9O",
      "type": "text",
      "x": 263.2491816377815,
      "y": 227.2492561021436,
      "width": 795.1192626953125,
      "height": 600,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
